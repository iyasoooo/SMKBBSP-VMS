# SMKBBSP VisitorPass - local environment template
#
# Copy to `.env` and replace every CHANGE_ME value:
#   cp .env.example .env          (PowerShell: Copy-Item .env.example .env)
#
# Generate the three secrets below with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# NEVER commit `.env`. NEVER reuse these demo values outside local development.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Matches docker-compose.yml. Change if you run PostgreSQL elsewhere.
DATABASE_URL="postgresql://visitorpass:visitorpass_local_dev@localhost:5432/visitorpass?schema=public"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Absolute origin used to build private visitor links and QR pass URLs.
APP_URL="http://localhost:3000"
NODE_ENV="development"

# IANA timezone used for all human-facing dates. Storage is always UTC.
APP_TIMEZONE="Asia/Kuala_Lumpur"

# ---------------------------------------------------------------------------
# Secrets - 32 random bytes, base64 encoded. All three MUST differ.
# ---------------------------------------------------------------------------
# Signs/derives nothing on its own; used as the pepper for session token hashing.
SESSION_SECRET="CHANGE_ME_session_secret_base64_32_bytes"

# AES-256-GCM key protecting retrievable identity values (NRIC/passport).
# Rotating this key requires re-encrypting existing rows; the key version
# recorded on each row exists to make that possible.
IDENTITY_ENCRYPTION_KEY="CHANGE_ME_encryption_key_base64_32_bytes"
IDENTITY_KEY_VERSION="1"

# HMAC-SHA-256 key for deterministic identity matching (blacklist/dedupe).
# Changing this invalidates all existing match values.
IDENTITY_HMAC_KEY="CHANGE_ME_hmac_key_base64_32_bytes"

# ---------------------------------------------------------------------------
# Email (Mailpit locally - no credentials required)
# ---------------------------------------------------------------------------
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM_NAME="SMKBBSP VisitorPass"
MAIL_FROM_ADDRESS="visitorpass@smkbbsp.test"

# ---------------------------------------------------------------------------
# Local demo seed passwords (development only)
# ---------------------------------------------------------------------------
# The seed refuses to run with these values when NODE_ENV=production.
SEED_ADMIN_PASSWORD="Admin#Demo2025"
SEED_GUARD_PASSWORD="Guard#Demo2025"
SEED_TEACHER_PASSWORD="Teacher#Demo2025"

# ---------------------------------------------------------------------------
# Card reading (optional)
# ---------------------------------------------------------------------------
# OCR assistance on the visitor form reads a photographed identity card with a
# vision model served by Ollama. The browser never talks to it: the photo goes
# to this application's own /api/ocr, which calls the address below.
#
# Leave OCR_OLLAMA_URL empty and the scan panel disappears entirely - the form
# is simply typed in. That is the intended behaviour anywhere without a model
# host, and it is also what happens by itself when the host is simply switched
# off, so nothing breaks on a day the model machine stays shut.
#
# The value below is for local development, where Ollama runs on the same
# machine. IN THE DEPLOYED SYSTEM IT IS NOT: the model runs on a laptop at the
# school and the server reaches it over a Tailscale private network, so this
# becomes that laptop's tailnet address:
#
#   OCR_OLLAMA_URL="http://100.x.y.z:11434"
#
# Use the numeric 100.x address rather than the MagicDNS name. The application
# runs in a container and resolves names through Docker's DNS, not the host's,
# so a MagicDNS name that works in the server's own shell usually fails inside
# the container. See HOSTING.md, "Card reading: a model host on the tailnet".
#
# Ollama has no authentication of any kind. The tailnet is the whole of the
# access control, so the model port must never be published or forwarded.
#
# The model name is compared against the host's installed models and a mismatch
# is refused. Do not point this at a cloud-routed tag - `gpt-oss:120b-cloud` and
# the like proxy to ollama.com, and an identity card must not leave the school.
# The application refuses to start with one, so a mistake here is a boot failure
# rather than a quiet leak.
OCR_OLLAMA_URL="http://127.0.0.1:11434"
OCR_OLLAMA_MODEL="qwen3.5:0.8b"
# 45s suits a model on the same machine. Across the tailnet, raise it - the
# first read after an idle period also pays for loading the model into memory.
OCR_TIMEOUT_MS="45000"
