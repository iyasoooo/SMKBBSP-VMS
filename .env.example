# SMKBBSP VisitorPass - local environment template
#
# Copy to `.env` and replace every CHANGE_ME value:
#   cp .env.example .env          (PowerShell: Copy-Item .env.example .env)
#
# Generate the three secrets below with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# NEVER commit `.env`. NEVER reuse these demo values outside local development.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Matches docker-compose.yml. Change if you run PostgreSQL elsewhere.
DATABASE_URL="postgresql://visitorpass:visitorpass_local_dev@localhost:5432/visitorpass?schema=public"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Absolute origin used to build private visitor links and QR pass URLs.
APP_URL="http://localhost:3000"
NODE_ENV="development"

# IANA timezone used for all human-facing dates. Storage is always UTC.
APP_TIMEZONE="Asia/Kuala_Lumpur"

# ---------------------------------------------------------------------------
# Secrets - 32 random bytes, base64 encoded. All three MUST differ.
# ---------------------------------------------------------------------------
# Signs/derives nothing on its own; used as the pepper for session token hashing.
SESSION_SECRET="CHANGE_ME_session_secret_base64_32_bytes"

# AES-256-GCM key protecting retrievable identity values (NRIC/passport).
# Rotating this key requires re-encrypting existing rows; the key version
# recorded on each row exists to make that possible.
IDENTITY_ENCRYPTION_KEY="CHANGE_ME_encryption_key_base64_32_bytes"
IDENTITY_KEY_VERSION="1"

# HMAC-SHA-256 key for deterministic identity matching (blacklist/dedupe).
# Changing this invalidates all existing match values.
IDENTITY_HMAC_KEY="CHANGE_ME_hmac_key_base64_32_bytes"

# ---------------------------------------------------------------------------
# Email (Mailpit locally - no credentials required)
# ---------------------------------------------------------------------------
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM_NAME="SMKBBSP VisitorPass"
MAIL_FROM_ADDRESS="visitorpass@smkbbsp.test"

# ---------------------------------------------------------------------------
# Local demo seed passwords (development only)
# ---------------------------------------------------------------------------
# The seed refuses to run with these values when NODE_ENV=production.
SEED_ADMIN_PASSWORD="Admin#Demo2025"
SEED_GUARD_PASSWORD="Guard#Demo2025"
SEED_TEACHER_PASSWORD="Teacher#Demo2025"
